# Git for Windows checks out text files with CRLF by default
# (core.autocrlf=true), but sh can't run a script whose lines end in \r.
# Force LF for the hooks so the pre-commit guard works on Windows too.
.githooks/* text eol=lf

# Three Builders can run in parallel worktrees, and every one of them appends
# to the agent log. Union merge keeps both sides of an append instead of
# conflicting on every parallel dispatch.
notes/agents/log.md merge=union
