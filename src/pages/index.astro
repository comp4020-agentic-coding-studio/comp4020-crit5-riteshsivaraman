---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>COMP4020 prototype</title>
    <meta
      name="description"
      content="Replace this with one sentence saying what this page is. A search result and a link preview both show it."
    />

    <!--
      The link-preview card: public/card.png, 1200x630 --- replace it. The URL
      resolves against this page, like any link. No og:title/og:description:
      scrapers fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

  </head>
  <body>
    <header>
      <nav aria-label="Primary">
        <a href="./">Home</a>
        <button id="mute-toggle" type="button" aria-label="Mute sound">🔊</button>
      </nav>
    </header>
    <main>
      <h1>Remnant</h1>
      <div id="game-shell">
        <canvas id="game-canvas" aria-label="Remnant game view"></canvas>
        <div id="game-controls" hidden></div>
      </div>
    </main>
    <script src="../scripts/main.ts"></script>
    <script src="../scripts/audio.ts"></script>
  </body>
</html>
